{
  "name": "nba-stats-tracker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "deploy": "next build && touch out/.nojekyll",
    "data:fetch": "python scripts/fetch_data.py",
    "data:update": "python scripts/app.py",
    "api:start": "python app.py",
    "api:dev": "nodemon --exec python app.py",
    "dev:all": "concurrently \"npm run dev\" \"npm run api:dev\"",
    "clean": "node scripts/cleanup.js",
    "fresh": "rm -rf .next && npm run dev",
    "fix-config": "node scripts/fix-next-config.js",
    "start-app": "node scripts/start-app.js",
    "check-app": "node scripts/check-app.js",
    "fix-css": "node scripts/fix-css.js",
    "fix-app": "node scripts/fix-app.js",
    "fix-src-app": "node scripts/fix-src-app.js",
    "fix-css-imports": "node scripts/fix-css-imports.js",
    "clean-start": "node scripts/clean-start.js"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "autoprefixer": "^10.4.16",
    "axios": "^1.6.2",
    "chart.js": "^4.4.8",
    "framer-motion": "^12.5.0",
    "lucide-react": "^0.483.0",
    "next": "13.5.8",
    "next-themes": "^0.4.4",
    "postcss": "^8.4.31",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.5.0",
    "react-toastify": "^9.1.3",
    "tailwindcss": "^3.3.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^8.0.0",
    "eslint-config-next": "13.5.8",
    "nodemon": "^3.0.2"
  }
}
